{
  "format": "orbital-economy-change-policy-v1",
  "name": "Orbital Economy v7.7.11 Population - change contract DRAFT (owner); executor finalises and justifies every change",
  "description": "Written before implementation from V7_7_11_ARCHITECTURE_SPEC.md. Accepted baseline: v7.7.10 r1. No switch, no new Mode: every Mode 0-48 must reproduce it exactly; the only change is the added population layer.",
  "accepted_model_sha256": "3cb40c883703936af3550a82a731d4af17f3818afe80b69c0c8f92e0878ab903",
  "validation_sha256": "49f806b2ccd0b776c5c1e65e8687fad09f9ccad375e2edb2a36da9d22a814841",
  "comparison": {
    "abs_tolerance": 0,
    "rel_tolerance": null,
    "rel_floor": 1e-12
  },
  "engine": {
    "package": "simulation",
    "version": "9.0.0"
  },
  "default_action": "deny",
  "require_full_mode_coverage": true,
  "rules": [
    {
      "id": "regression-guard-modes-0-48",
      "action": "deny",
      "event": "series_changed",
      "modes": "0-48",
      "name": "*",
      "note": "No switch: population is accounted only and drives nothing in the economy, so every Mode must reproduce v7.7.10 r1 exactly (first match wins)."
    },
    {
      "id": "forbid-removals-and-structural-drift",
      "action": "deny",
      "event": [
        "element_removed",
        "series_removed",
        "mode_removed",
        "mode_added",
        "link_removed",
        "type_changed",
        "definition_changed",
        "simulation_changed",
        "time_axis_changed",
        "scenario_renamed",
        "scenario_input_changed"
      ],
      "name": "*"
    },
    {
      "id": "add-population",
      "action": "allow",
      "event": "element_added",
      "name": [
        "Population Birth Rate",
        "Population Base Death Rate",
        "Death Living Standard Sensitivity",
        "Labor Participation Share",
        "Migration Max Rate",
        "Migration Gap Sensitivity",
        "Attractiveness Perception Time",
        "Attractiveness Wage Weight",
        "Attractiveness Jobs Weight",
        "Attractiveness Living Weight",
        "Reference Real Wage",
        "Living Energy Weight",
        "? Population Initial",
        "? Population",
        "? Births",
        "? Deaths",
        "? Labor Force",
        "? Employment",
        "? Employment Rate",
        "? Unemployment",
        "? Labor Shortage",
        "? Price Index",
        "? Real Wage",
        "? Living Standard",
        "? Attractiveness",
        "? Perceived Attractiveness",
        "? Perceived Attractiveness Increase",
        "? Perceived Attractiveness Decrease",
        "Attractiveness Gap ? to ?",
        "Migration ? to ?",
        "Planet Population"
      ],
      "required": true,
      "note": "the population node generated from its declaration: parameters, per region population stock, births, deaths, labor accounting, price index, real wage, living standard, attractiveness and its perception; migration flows between regions; planet total (V7_7_11_ARCHITECTURE_SPEC §2)"
    },
    {
      "id": "link-into-new-elements",
      "action": "allow",
      "event": "link_added",
      "name": [
        "* -> Population Birth Rate",
        "* -> Population Base Death Rate",
        "* -> Death Living Standard Sensitivity",
        "* -> Labor Participation Share",
        "* -> Migration Max Rate",
        "* -> Migration Gap Sensitivity",
        "* -> Attractiveness Perception Time",
        "* -> Attractiveness Wage Weight",
        "* -> Attractiveness Jobs Weight",
        "* -> Attractiveness Living Weight",
        "* -> Reference Real Wage",
        "* -> Living Energy Weight",
        "* -> ? Population Initial",
        "* -> ? Population",
        "* -> ? Births",
        "* -> ? Deaths",
        "* -> ? Labor Force",
        "* -> ? Employment",
        "* -> ? Employment Rate",
        "* -> ? Unemployment",
        "* -> ? Labor Shortage",
        "* -> ? Price Index",
        "* -> ? Real Wage",
        "* -> ? Living Standard",
        "* -> ? Attractiveness",
        "* -> ? Perceived Attractiveness",
        "* -> ? Perceived Attractiveness Increase",
        "* -> ? Perceived Attractiveness Decrease",
        "* -> Attractiveness Gap ? to ?",
        "* -> Migration ? to ?",
        "* -> Planet Population"
      ]
    },
    {
      "id": "new-series-everywhere",
      "action": "allow",
      "event": "series_added",
      "name": [
        "Population Birth Rate",
        "Population Base Death Rate",
        "Death Living Standard Sensitivity",
        "Labor Participation Share",
        "Migration Max Rate",
        "Migration Gap Sensitivity",
        "Attractiveness Perception Time",
        "Attractiveness Wage Weight",
