        "Reference Real Wage",
        "Living Energy Weight",
        "? Population Initial",
        "? Population",
        "? Births",
        "? Deaths",
        "? Labor Force",
        "? Employment",
        "? Employment Rate",
        "? Unemployment",
        "? Labor Shortage",
        "? Price Index",
        "? Real Wage",
        "? Living Standard",
        "? Attractiveness",
        "? Perceived Attractiveness",
        "? Perceived Attractiveness Increase",
        "? Perceived Attractiveness Decrease",
        "Attractiveness Gap ? to ?",
        "Migration ? to ?",
        "Planet Population"
      ]
    }
  ]
