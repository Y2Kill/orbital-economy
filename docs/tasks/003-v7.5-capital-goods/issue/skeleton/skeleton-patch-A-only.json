{
  "format": "orbital-economy-model-patch-v1",
  "base_sha256": "07ce33e004597ef485e47e3a95026b584197824468382e28daa80950a45fb08e",
  "name": "Orbital Economy v7.5 SKELETON (A: capital goods + refinery/power expansion)",
  "add_elements": [
    {
      "type": "VARIABLE",
      "name": "Capital Goods Enabled",
      "behavior": {
        "value": 1
      },
      "description": "v7.5 master switch: expansion of installed capital consumes capital goods produced from metal and electronics."
    },
    {
      "type": "VARIABLE",
      "name": "Metal per Capital Goods Unit",
      "behavior": {
        "value": 1
      }
    },
    {
      "type": "VARIABLE",
      "name": "Electronics per Capital Goods Unit",
      "behavior": {
        "value": 0.5
      }
    },
    {
      "type": "VARIABLE",
      "name": "Capital Goods Target Days",
      "behavior": {
        "value": 30
      }
    },
    {
      "type": "VARIABLE",
      "name": "Capital Goods Adjustment Time",
      "behavior": {
        "value": 20
      }
    },
    {
      "type": "VARIABLE",
      "name": "Capital Goods Buffer",
      "behavior": {
        "value": 2
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Refinery Capital Goods per Capacity",
      "behavior": {
        "value": 17
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Power Capital Goods per Capacity",
      "behavior": {
        "value": 0.5
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Capital Goods Production Capacity",
      "behavior": {
        "value": 2
      }
    },
    {
      "type": "STOCK",
      "name": "A Capital Goods Inventory",
      "behavior": {
        "initial_value": 30,
        "non_negative": true
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Refinery Desired Expansion",
      "behavior": {
        "value": "(([A Refinery Gap Limited Construction]) + ([A Refinery Finance Limited Construction]) - (((([A Refinery Gap Limited Construction]) - ([A Refinery Finance Limited Construction])) ^ 2) ^ 0.5)) / 2"
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Power Desired Expansion",
      "behavior": {
        "value": "[Capital Lifecycle Enabled] * [A Power Gap Limited Construction]"
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Capital Goods Fulfillment",
      "behavior": {
        "value": "IfThenElse([Capital Goods Enabled] = 1, [A Capital Goods Inventory] / ([A Capital Goods Inventory] + [Capital Goods Buffer]), 1)"
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Capital Goods Demand",
      "behavior": {
        "value": "[A Refinery Desired Expansion] * [A Refinery Capital Goods per Capacity] + [A Power Desired Expansion] * [A Power Capital Goods per Capacity]"
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Capital Goods Target Inventory",
      "behavior": {
        "value": "[A Capital Goods Demand] * [Capital Goods Target Days]"
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Desired Capital Goods Production",
      "behavior": {
        "value": "Max(0, [A Capital Goods Demand] + ([A Capital Goods Target Inventory] - [A Capital Goods Inventory]) / [Capital Goods Adjustment Time])"
      }
    },
    {
      "type": "VARIABLE",
      "name": "A Capital Goods Production Rate",
      "behavior": {
        "value": "IfThenElse([Capital Goods Enabled] = 1, [A Desired Capital Goods Production] / (1 + ([A Desired Capital Goods Production] / ([A Capital Goods Production Capacity] + 0.001)) ^ 8) ^ 0.125 * [A Metal Inventory] / ([A Metal Inventory] + [A Metal Buffer]) * [A Electronics Inventory] / ([A Electronics Inventory] + [A Electronics Buffer]), 0)"
      }
    },
    {
      "type": "FLOW",
      "name": "A Capital Goods Production",
      "from": null,
      "to": "A Capital Goods Inventory",
      "behavior": {
        "value": "[A Capital Goods Production Rate]",
        "non_negative": true
      }
    },
    {
      "type": "FLOW",
      "name": "A Capital Goods Metal Consumption",
      "from": "A Metal Inventory",
      "to": null,
      "behavior": {
        "value": "[A Capital Goods Production Rate] * [Metal per Capital Goods Unit]",
        "non_negative": true
      }
    },
    {
      "type": "FLOW",
      "name": "A Capital Goods Electronics Consumption",
      "from": "A Electronics Inventory",
      "to": null,
      "behavior": {
        "value": "[A Capital Goods Production Rate] * [Electronics per Capital Goods Unit]",
        "non_negative": true
      }
    },
    {
      "type": "FLOW",
      "name": "A Refinery Capital Goods Consumption",
      "from": "A Capital Goods Inventory",
      "to": null,
      "behavior": {
        "value": "[A Refinery Expansion] * [A Refinery Capital Goods per Capacity]",
        "non_negative": true
      }
    },
    {
      "type": "FLOW",
      "name": "A Power Capital Goods Consumption",
      "from": "A Capital Goods Inventory",
      "to": null,
      "behavior": {
        "value": "[A Power Generation Expansion] * [A Power Capital Goods per Capacity]",
        "non_negative": true
      }
    }
  ],
  "replace_formulas": [
    {
      "name": "A Refinery Expansion",
      "value": "IfThenElse([Capital Goods Enabled] = 1, [A Refinery Desired Expansion] * [A Capital Goods Fulfillment], (([A Refinery Gap Limited Construction]) + ([A Refinery Finance Limited Construction]) - (((([A Refinery Gap Limited Construction]) - ([A Refinery Finance Limited Construction])) ^ 2) ^ 0.5)) / 2)"
    },
    {
      "name": "A Power Generation Expansion",
      "value": "IfThenElse([Capital Goods Enabled] = 1, [A Power Desired Expansion] * [A Capital Goods Fulfillment], [Capital Lifecycle Enabled] * [A Power Gap Limited Construction])"
    }
  ],
