        "Electronics per Capital Goods Unit",
        "Capital Goods Target Days",
        "Capital Goods Adjustment Time",
        "Capital Goods Buffer",
        "? Capital Goods Inventory",
        "? Capital Goods Demand",
        "? Capital Goods Target Inventory",
        "? Desired Capital Goods Production",
        "? Capital Goods Production Rate",
        "? Capital Goods Production Capacity",
        "? Capital Goods Production",
        "? Capital Goods Metal Consumption",
        "? Capital Goods Electronics Consumption",
        "? Capital Goods Fulfillment",
        "? Refinery Desired Expansion",
        "? Electronics Desired Expansion",
        "? Power Desired Expansion",
        "? Refinery Capital Goods Consumption",
        "? Electronics Capital Goods Consumption",
        "? Power Capital Goods Consumption",
        "? Refinery Capital Goods per Capacity",
        "? Electronics Capital Goods per Capacity",
        "? Power Capital Goods per Capacity",
        "? Capital Goods Base Production Capacity",
        "Test 22 *",
        "Test 23 *",
        "v7.5 *",
        "? Test 22 * Applies",
        "? Test 23 * Applies",
        "* Capital Goods *"
      ],
      "required": true
    }
  ]
}
